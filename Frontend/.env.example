# URL del Backend API (producción)
# Ejemplo: https://api.tudominio.com
PUBLIC_API_URL=

# Número de WhatsApp Business (código de país + número sin espacios ni guiones)
# Ejemplo: 573015179340 (Colombia)
PUBLIC_WHATSAPP_NUMBER=573015179340

# ─── Asesor IA (chat con Gemini) ─────────────────────────────────────
# Clave de la API de Gemini (Google AI Studio: https://aistudio.google.com/apikey).
# Es un secreto SOLO de servidor: nunca se expone al cliente ni se sube al repo.
# En producción se configura en Vercel → Settings → Environment Variables.
GEMINI_API_KEY=

# (Opcional) Modelo de Gemini. Por defecto: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash

# ─── Proxy de modelos 3D (src/pages/api/proxy-model.ts) ──────────────
# Host del MinIO desde el que se sirven los GLB. Solo este host (además de
# api.jkmobiliario.digital y 2.25.126.250) puede proxearse.
# Ejemplo: 2.25.126.250
MINIO_ENDPOINT=

# Permitir localhost/127.0.0.1 como destino del proxy. SOLO desarrollo:
# por defecto está deshabilitado para evitar SSRF hacia servicios locales.
PROXY_ALLOW_LOCALHOST=false
