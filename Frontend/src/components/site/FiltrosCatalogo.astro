---
interface Props {
  busqueda?: string;
  anchoMin?: string;
  anchoMax?: string;
  largoMin?: string;
  largoMax?: string;
}

const {
  busqueda = "",
  anchoMin = "",
  anchoMax = "",
  largoMin = "",
  largoMax = "",
} = Astro.props;

/** Campos de medida del formulario: etiqueta y valores para los inputs. */
const gruposMedida = [
  { etiqueta: "ANCHO (cm)", nombreMin: "anchoMin", nombreMax: "anchoMax", valorMin: anchoMin, valorMax: anchoMax },
  { etiqueta: "LARGO (cm)", nombreMin: "largoMin", nombreMax: "largoMax", valorMin: largoMin, valorMax: largoMax },
];

const inputMedida =
  "h-[32px] w-[50px] rounded-[10px] border border-jk-gold bg-transparent px-[6px] text-center font-sans text-[14px] font-medium text-jk-ink outline-none placeholder:text-[#49454F]";

const chipBase =
  "inline-flex h-[32px] items-center justify-center rounded-[10px] px-[11px] font-brand text-[16px] font-medium transition-colors";
const chipOn = "bg-jk-gold-soft text-white";
---

<form method="GET" class="pt-[23px]">
  <label
    class="flex h-[42px] w-full items-center gap-[10px] rounded-[18px] border border-jk-gold bg-white pl-[18px] lg:w-[606px]"
  >
    <svg
      class="size-5 shrink-0 text-jk-ink"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5"></path>
    </svg>
    <input
      type="search"
      name="q"
      value={busqueda}
      placeholder="Buscar"
      class="w-full bg-transparent font-sans text-[16px] text-jk-ink outline-none placeholder:text-[#6b6b6b]"
    />
  </label>

  <div class="mt-[40px]">
    <p class="font-sans text-[15px] font-light text-jk-gold-muted">MEDIDAS</p>
    <span class="block h-px w-[184px] bg-jk-gold"></span>
  </div>

  <div class="mt-[9px] flex flex-wrap items-end gap-x-[24px] gap-y-[10px]">
    {
      gruposMedida.map(({ etiqueta, nombreMin, nombreMax, valorMin, valorMax }) => (
        <div>
          <p class="font-sans text-[13px] font-light text-jk-gold-muted">{etiqueta}</p>
          <div class="mt-[4px] flex items-center gap-[9px]">
            <label class="sr-only" for={nombreMin}>
              {etiqueta} mínimo
            </label>
            <input
              type="number"
              id={nombreMin}
              name={nombreMin}
              value={valorMin}
              placeholder="MIN"
              min="0"
              step="any"
              class={inputMedida}
            />
            <span class="font-sans text-[14px] text-jk-gold-muted" aria-hidden="true">
              –
            </span>
            <label class="sr-only" for={nombreMax}>
              {etiqueta} máximo
            </label>
            <input
              type="number"
              id={nombreMax}
              name={nombreMax}
              value={valorMax}
              placeholder="MAX"
              min="0"
              step="any"
              class={inputMedida}
            />
          </div>
        </div>
      ))
    }

    <button
      type="submit"
      class:list={[chipBase, "w-[33px] px-0", chipOn]}
      aria-label="Aplicar filtro de medidas"
    >
      <svg
        class="size-[14px]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m9 6 6 6-6 6"></path>
      </svg>
    </button>
  </div>
</form>
