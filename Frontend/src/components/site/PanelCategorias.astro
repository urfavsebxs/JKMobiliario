---
import { agruparCategorias, categoriasConRespaldo, normalizarCategoria, slugDeCategoria } from "../../lib/categorias";
import { getCategorias } from "../../lib/api";

interface Props {
  /** Slug de la categoría activa (el de la URL) para marcarla visualmente. */
  activa?: string;
}

const { activa = "" } = Astro.props;

// Caché por request: Nav renderiza este panel dos veces (escritorio y móvil)
// y solo la primera petición consulta la API. Si falla o vuelve vacía se
// aplica el respaldo local, de modo que nunca se pinta una lista vacía.
const cats =
  Astro.locals.categorias ?? (Astro.locals.categorias = categoriasConRespaldo(await getCategorias()));

const grupos = agruparCategorias(cats).map((grupo) => ({
  titulo: grupo.titulo,
  categorias: grupo.categorias.map((categoria) => ({
    nombre: categoria.name,
    slug: slugDeCategoria(categoria.name),
  })),
}));

const activaNormalizada = normalizarCategoria(activa);

const esActiva = (slug: string) =>
  activaNormalizada !== "" && normalizarCategoria(slug) === activaNormalizada;

const tituloBase =
  "font-sans text-[20px] font-bold leading-[30px] text-white lg:text-[24px] lg:leading-[36px]";
const enlaceBase = "block font-sans text-[16px] leading-[32px] transition-colors";
const enlaceOn = "text-jk-gold";
const enlaceOff = "text-white/70 hover:text-white";
---

<nav
  aria-label="Categorías del catálogo"
  class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-3 lg:flex lg:flex-row lg:gap-x-[24px]"
>
  {
    grupos.map((grupo) => {
      // "Comedores" es a la vez área y categoría: el título hace de enlace para
      // no repetir el mismo texto dos veces en la misma columna.
      const tituloEsEnlace =
        grupo.categorias.length === 1 &&
        normalizarCategoria(grupo.categorias[0].nombre) === normalizarCategoria(grupo.titulo);
      const unica = grupo.categorias[0];

      return (
        <div class="min-w-0 lg:flex-1">
          {tituloEsEnlace ? (
            <a
              href={`/catalogo/${unica.slug}`}
              aria-current={esActiva(unica.slug) ? "page" : undefined}
              class:list={[
                tituloBase,
                "inline-block transition-colors",
                esActiva(unica.slug) ? enlaceOn : "hover:text-jk-gold",
              ]}
            >
              {grupo.titulo}
            </a>
          ) : (
            <p class={tituloBase}>{grupo.titulo}</p>
          )}

          <span class="mt-[10px] block h-px w-[79px] bg-jk-gold/85" aria-hidden="true" />

          {!tituloEsEnlace && (
            <ul class="mt-[6px]">
              {grupo.categorias.map((categoria) => (
                <li>
                  <a
                    href={`/catalogo/${categoria.slug}`}
                    aria-current={esActiva(categoria.slug) ? "page" : undefined}
                    class:list={[
                      enlaceBase,
                      esActiva(categoria.slug) ? enlaceOn : enlaceOff,
                    ]}
                  >
                    {categoria.nombre}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      );
    })
  }
</nav>
