---
const whatsapp = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const waHref = whatsapp ? `https://wa.me/${whatsapp}` : "/#contacto";

// Dirección del local (JK Mobiliario S.A.S, Medellín) para abrir en mapas.
const direccion =
  "Carrera 52 #7 Sur -22, Mall Providencia, Avenida Guayabal, Medellín, Antioquia, Colombia";
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(direccion)}`;
const wazeHref = `https://waze.com/ul?q=${encodeURIComponent(direccion)}&navigate=yes`;

const navLinks = [
  { label: "Inicio", href: "/" },
  { label: "Catálogo", href: "/catalogo" },
  { label: "Nosotros", href: "/#nosotros" },
  { label: "Contáctanos", href: waHref },
];

const serviceLinks = [
  { label: "Registrate", href: "/login", asesor: false },
  { label: "Privacidad", href: "/#contacto", asesor: false },
  { label: "Asesoría", href: "/#contacto", asesor: false },
  { label: "Asistente IA", href: "/#contacto", asesor: true },
];

const social = [
  {
    icon: "/images/jk/icon-fb.png",
    label: "@jkmobiliario",
    href: "https://web.facebook.com/profile.php?id=100071627034291",
  },
  {
    icon: "/images/jk/icon-ig.png",
    label: "@jkmobiliario_",
    href: "https://www.instagram.com/jkmobiliario_/",
  },
  {
    icon: "/images/jk/icon-tiktok.svg",
    label: "@jkmobiliario_",
    href: "https://www.tiktok.com/@jkmobiliario_",
  },
  { icon: "/images/jk/icon-wsp.png", label: "324 669 2370", href: waHref },
];

const linkClass =
  "font-sans text-[15px] font-semibold leading-[normal] text-white transition-opacity hover:opacity-70";
---

<footer class="bg-black text-white">
  <div class="mx-auto max-w-[1440px] px-5 lg:px-[80px]">
    <div class="border-t border-white/25">
      <div class="grid gap-y-10 py-10 lg:grid-cols-[386fr_169fr_175fr_190fr_360fr] lg:gap-y-0 lg:py-0">
        <div class="lg:py-[66px] lg:pl-[84px]">
          <p class="font-sans text-[20px] font-normal leading-[1.5] lg:text-[24px]">
            JK MOBILIARIO
          </p>
        </div>

        <div class="lg:py-[66px]">
          <ul class="flex flex-col gap-[13px] lg:min-h-[127px] lg:border-l lg:border-white/25 lg:pl-[13px]">
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class={linkClass}
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:py-[66px]">
          <ul class="flex flex-col gap-[13px] lg:min-h-[127px] lg:border-l lg:border-white/25 lg:pl-[13px]">
            {
              serviceLinks.map((link) => (
                <li>
                  <a href={link.href} class={linkClass} data-jk-asesor={link.asesor ? "" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:py-[66px]">
          <ul class="flex flex-col gap-[9px] lg:min-h-[127px] lg:border-l lg:border-white/25 lg:pl-[13px]">
            {
              social.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-[5px] transition-opacity hover:opacity-80"
                  >
                    <img
                      src={item.icon}
                      alt=""
                      width="38"
                      height="38"
                      class="size-[38px] shrink-0 object-contain"
                      loading="lazy"
                    />
                    <span class="font-sans text-[13px] font-semibold text-white">
                      {item.label}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:py-[66px]">
          <details class="jk-ubi lg:min-h-[127px] lg:border-l lg:border-white/25 lg:pl-[10px]">
            <summary
              class="flex cursor-pointer items-start gap-[7px] rounded-md"
              aria-label="Ver la dirección en Google Maps o Waze"
            >
              <img
                src="/images/jk/icon-ubi.png"
                alt=""
                width="33"
                height="50"
                class="h-[50px] w-[33px] shrink-0 object-contain"
                loading="lazy"
              />
              <address
                class="font-sans text-[15px] font-semibold not-italic leading-[normal] text-white"
              >
                Carrera 52 #7 Sur -22<br />Mall providencia<br />Avenida Guayabal<br />Medellín
                <span
                  class="mt-[6px] flex items-center gap-1 font-sans text-[12px] font-semibold text-jk-gold"
                >
                  Ver en mapas
                  <svg
                    class="jk-ubi-chevron transition-transform duration-200"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    width="12"
                    height="12"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </span>
              </address>
            </summary>

            <ul class="mt-3 flex flex-col gap-2 border-l border-white/25 pl-[42px]">
              <li>
                <a
                  href={mapsHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 font-sans text-[14px] font-semibold text-white transition-colors hover:text-jk-gold"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    width="16"
                    height="16"
                    class="shrink-0 text-jk-gold"
                    aria-hidden="true"
                  >
                    <path d="M12 21s-7-4.6-7-11a7 7 0 1 1 14 0c0 6.4-7 11-7 11Z"></path>
                    <circle cx="12" cy="10" r="2.5"></circle>
                  </svg>
                  Google Maps
                </a>
              </li>
              <li>
                <a
                  href={wazeHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-2 font-sans text-[14px] font-semibold text-white transition-colors hover:text-jk-gold"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    width="16"
                    height="16"
                    class="shrink-0 text-jk-gold"
                    aria-hidden="true"
                  >
                    <path d="M12 21s-7-4.6-7-11a7 7 0 1 1 14 0c0 6.4-7 11-7 11Z"></path>
                    <path d="m9.5 10 2 2 3.5-4"></path>
                  </svg>
                  Waze
                </a>
              </li>
            </ul>
          </details>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .jk-ubi summary {
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .jk-ubi summary::-webkit-details-marker {
    display: none;
  }

  .jk-ubi[open] .jk-ubi-chevron {
    transform: rotate(180deg);
  }
</style>
