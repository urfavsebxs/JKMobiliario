---
import PanelCategorias from "./PanelCategorias.astro";

interface Props {
  /** "overlay" se monta sobre la imagen del hero; "solid" usa fondo claro. */
  mode?: "overlay" | "solid";
  /** Ruta activa, sólo para el estado visual del enlace. */
  active?: string;
}

const { mode = "solid", active = "" } = Astro.props;
const overlay = mode === "overlay";

const links = [
  { label: "Inicio", href: "/", subcategorias: false },
  { label: "Catálogo", href: "/catalogo", subcategorias: true },
  { label: "Nosotros", href: "/#nosotros", subcategorias: false },
];

// `pointer-events-auto`: el contenedor de la cabecera es transparente al ratón
// (ver comentario en el div) y cada control reactiva la interacción.
const linkBase =
  "jk-nav-ink pointer-events-auto font-sans text-[16px] font-medium transition-[color,opacity] hover:opacity-70 lg:text-[20px]";

// El grupo abarca toda la altura de la cabecera para que el ratón pueda bajar
// desde el enlace hasta el panel sin que el hover se pierda por el camino.
const grupoAltura = overlay ? "lg:h-[126px]" : "lg:h-[150px]";

// En /catalogo/<slug> el panel de categorías marca la activa (también en el
// desplegable y en el menú móvil, no solo en la banda del hero).
const rutaCategoria =
  Astro.url.pathname.match(/^\/catalogo\/([^/]+)\/?$/)?.[1] ?? "";
const categoriaActiva = rutaCategoria ? decodeURIComponent(rutaCategoria) : "";

// En /catalogo y /catalogo/<slug> la propia página ya pinta el panel completo
// de categorías en su banda oscura. Si aquí se mantuviera el desplegable, al
// pasar el ratón (o enfocar) "Catálogo" aparecería un segundo panel detrás del
// hero, duplicando las categorías. En esas rutas el enlace va sin grupo, sin
// panel y sin atributos ARIA de desplegable; el menú móvil no se ve afectado.
const enCatalogo = /^\/catalogo(\/|$)/.test(Astro.url.pathname);

const whatsapp = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const contactHref = whatsapp ? `https://wa.me/${whatsapp}` : "/#contacto";
const contactTarget = whatsapp ? "_blank" : undefined;
const contactRel = whatsapp ? "noopener noreferrer" : undefined;

const wordmark = overlay ? "text-white" : "text-black";
const linkColor = overlay ? "text-jk-gold" : "text-black";

// Sobre la foto del hero el diseño no dibuja caja: sólo texto blanco.
const ctaClass = overlay
  ? "jk-btn-nav-overlay"
  : "jk-btn-nav shadow-[0px_1px_2px_0px_rgba(0,0,0,0.05)]";

const burgerColor = overlay ? "text-white" : "text-black";
const burgerHover = overlay ? "hover:bg-white/10" : "hover:bg-black/5";
---

<header
  class:list={[
    "jk-header left-0 right-0 top-0 z-50",
    overlay ? "absolute" : "jk-header-solid relative bg-jk-surface",
  ]}
>
  <!-- El contenedor no captura el ratón: así el panel de categorías (que vive
       detrás de esta capa, con z-index negativo) recibe el hover en cuanto el
       cursor sale del enlace "Catálogo", sin ningún hueco por el que perderse.
       Cada control reactiva los eventos con `pointer-events-auto`. -->
  <div
    class:list={[
      "pointer-events-none mx-auto flex max-w-[1440px] items-center gap-4 px-5 py-4 lg:gap-x-[32px] lg:py-0 lg:pl-[92px] lg:pr-[52px] xl:gap-x-[50px]",
      overlay ? "lg:h-[126px]" : "lg:h-[150px]",
    ]}
  >
    <a
      href="/"
      class:list={[
        "jk-nav-ink pointer-events-auto font-brand text-[26px] font-medium tracking-[-0.25px] transition-[color,opacity] lg:text-[32px]",
        wordmark,
      ]}
    >
      JK Mobiliario
    </a>

    <!-- Navegación de escritorio: en móvil se sustituye por el menú hamburguesa -->
    <nav
      aria-label="Navegación principal"
      class="hidden lg:ml-auto lg:flex lg:items-center lg:justify-end lg:gap-[46px]"
    >
      {
        links.map((link) =>
          link.subcategorias && !enCatalogo ? (
            <div
              class:list={["jk-cat-group group/cat flex items-center", grupoAltura]}
              data-jk-cat-group
            >
              <a
                href={link.href}
                data-jk-cat-link
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="jk-cat-panel"
                class:list={[
                  linkBase,
                  linkColor,
                  active === link.href && "underline underline-offset-8",
                ]}
              >
                {link.label}
              </a>

              <div
                id="jk-cat-panel"
                data-jk-cat-panel
                class="jk-cat-panel pointer-events-auto invisible absolute inset-x-0 top-0 -z-10 hidden opacity-0 transition-opacity duration-150 lg:block"
              >
                <div class="bg-black/80">
                  <div
                    class:list={[
                      "jk-cat-panel-inner mx-auto max-w-[1440px] px-5 pt-16 pb-12 lg:px-[166px] lg:pb-[57px]",
                      // El contenido arranca justo en el borde inferior de la
                      // cabecera: así ningún enlace queda bajo la capa que la
                      // cabecera pinta por encima del panel y todos son
                      // clicables.
                      overlay ? "lg:pt-[126px]" : "lg:pt-[150px]",
                    ]}
                  >
                    <PanelCategorias activa={categoriaActiva} />
                  </div>
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class:list={[
                linkBase,
                linkColor,
                active === link.href && "underline underline-offset-8",
              ]}
            >
              {link.label}
            </a>
          ),
        )
      }
    </nav>

    <!-- Acceso al panel: en escritorio es un botón fantasma junto al CTA.
         El script lo convierte en "Panel"/"Mi cuenta" si hay sesión activa. -->
    <a
      href="/login"
      data-jk-login
      aria-label="Iniciar sesión"
      class:list={[
        "jk-nav-ink pointer-events-auto hidden items-center gap-2 rounded-lg border border-current/40 px-4 font-sans text-[15px] font-medium transition-opacity hover:opacity-70 lg:inline-flex lg:h-[44px]",
        linkColor,
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-[18px] w-[18px] shrink-0"
        aria-hidden="true"
      >
        <circle cx="12" cy="8" r="3.5"></circle>
        <path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"></path>
      </svg>
      <span data-jk-login-label class="hidden xl:inline">Iniciar sesión</span>
    </a>

    <!-- Cerrar sesión: sólo se muestra con sesión activa (lo controla el script
         y la clase [data-sesion="activa"] del header). -->
    <button
      type="button"
      data-jk-logout-escritorio
      data-jk-logout-btn
      aria-label="Cerrar sesión"
      title="Cerrar sesión"
      class:list={[
        "jk-nav-ink pointer-events-auto items-center gap-2 rounded-lg border border-current/40 px-4 font-sans text-[15px] font-medium transition-opacity hover:opacity-70 lg:h-[44px]",
        linkColor,
      ]}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-[18px] w-[18px] shrink-0"
        aria-hidden="true"
      >
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
        <polyline points="16 17 21 12 16 7"></polyline>
        <line x1="21" y1="12" x2="9" y2="12"></line>
      </svg>
    </button>

    <a
      href={contactHref}
      target={contactTarget}
      rel={contactRel}
      class:list={[
        "pointer-events-auto hidden items-center justify-center rounded-lg px-6 py-3 font-label text-[15px] font-medium text-white transition-opacity hover:opacity-90 lg:inline-flex lg:h-[51px] lg:px-[25px] lg:py-0 lg:text-[16px]",
        ctaClass,
      ]}
    >
      CONTÁCTANOS
    </a>

    <!-- Menú móvil: <details> garantiza el desplegable incluso sin JavaScript -->
    <details class="pointer-events-auto ml-auto lg:hidden" data-jk-menu>
      <summary
        class:list={[
          "jk-burger flex h-11 w-11 cursor-pointer items-center justify-center rounded-lg transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current",
          burgerColor,
          burgerHover,
        ]}
        aria-label="Menú de navegación"
        aria-controls="menu-movil"
      >
        <span class="jk-burger-box" aria-hidden="true">
          <span class="jk-burger-line"></span>
          <span class="jk-burger-line"></span>
          <span class="jk-burger-line"></span>
        </span>
      </summary>

      <!-- Misma banda oscura que el desplegable de escritorio: cubre toda la
           cabecera desde el borde superior y queda por detrás del contenido. -->
      <span
        class="jk-mobile-backdrop absolute inset-0 -z-10 bg-black/80"
        aria-hidden="true"
      ></span>

      <div id="menu-movil" class="jk-mobile-panel absolute inset-x-0 top-full -z-10 bg-black/80">
        <nav aria-label="Navegación móvil" class="mx-auto max-w-[1440px] px-5 pt-1 pb-6">
          <ul class="flex flex-col">
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      "flex min-h-[56px] items-center border-b border-white/10 font-sans text-[18px] font-medium text-jk-gold transition-opacity hover:opacity-70",
                      active === link.href && "underline underline-offset-8",
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <div class="border-t border-white/10 pt-6">
            <PanelCategorias activa={categoriaActiva} />
          </div>

          <a
            href={contactHref}
            target={contactTarget}
            rel={contactRel}
            class="jk-pill-gradient mt-6 flex h-[51px] items-center justify-center rounded-lg font-label text-[16px] font-medium text-jk-ink transition-opacity hover:opacity-90"
          >
            CONTÁCTANOS
          </a>

          <a
            href="/login"
            data-jk-login
            aria-label="Iniciar sesión"
            class="mt-3 flex h-[51px] items-center justify-center gap-2 rounded-lg border border-jk-gold/70 font-label text-[16px] font-medium text-jk-gold transition-colors hover:bg-white/5"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-[18px] w-[18px] shrink-0"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="3.5"></circle>
              <path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6"></path>
            </svg>
            <span data-jk-login-label>Iniciar sesión</span>
          </a>

          <button
            type="button"
            data-jk-logout-movil
            data-jk-logout-btn
            class="mt-3 h-[51px] w-full items-center justify-center gap-2 rounded-lg border border-white/30 font-label text-[16px] font-medium text-white/85 transition-colors hover:bg-white/10 hover:text-white"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-[18px] w-[18px] shrink-0"
              aria-hidden="true"
            >
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Cerrar sesión
          </button>
        </nav>
      </div>
    </details>
  </div>
</header>

<style is:global>
  /* El desplegable se controla con el atributo `data-open` que pone el script
     (hover con retardo) y, como respaldo, con `:hover`/`:focus-within`. No se
     usa `group-hover:` porque Tailwind envuelve esas utilidades en
     @media (hover: hover), que deja el panel inerte en dispositivos sin ratón.
     `data-escaping` lo fija Escape para que `:focus-within` no reabra el panel
     mientras el foco siga en el enlace "Catálogo". */
  @media (min-width: 64rem) {
    .jk-cat-group:not([data-escaping]):hover .jk-cat-panel,
    .jk-cat-group[data-open]:not([data-escaping]) .jk-cat-panel,
    .jk-cat-group:not([data-escaping]):focus-within .jk-cat-panel {
      visibility: visible;
      opacity: 1;
    }
  }

  /* Con el desplegable abierto la banda oscura pasa por detrás de toda la
     cabecera. Sobre el fondo claro del modo "solid" el texto negro quedaría
     ilegible, así que pasa a blanco mientras el ratón siga dentro. */
  .jk-header-solid:has(.jk-cat-group[data-open]:not([data-escaping])) .jk-nav-ink,
  .jk-header-solid:has(.jk-cat-group:not([data-escaping]):hover) .jk-nav-ink,
  .jk-header-solid:has(.jk-cat-group:not([data-escaping]):focus-within) .jk-nav-ink {
    color: #fff;
  }

  /* --------------------------------------------------------------------------
     Cabecera fija al hacer scroll
     - El script alterna `data-fija` en el <header> a partir de los 80px.
     - En modo "solid" el header vive en el flujo normal, así que al pasar a
       `fixed` se reserva su altura en <main> para que el contenido no dé un
       salto (mismo alto que ocupaba: 76px móvil / 150px escritorio).
     - La altura se compacta a 64px (móvil) / 72px (escritorio) con transición.
     - Sobre el fondo negro la tinta pasa a blanco también en modo "solid".
     -------------------------------------------------------------------------- */
  .jk-header[data-fija] {
    position: fixed;
    background-color: rgb(0 0 0 / 0.9);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .jk-header > div {
    transition:
      height 250ms ease,
      padding 250ms ease;
  }

  .jk-header[data-fija] > div {
    height: 64px;
    padding-top: 0;
    padding-bottom: 0;
  }

  .jk-header[data-fija] .jk-nav-ink,
  .jk-header[data-fija] .jk-burger {
    color: #fff;
  }

  .jk-header-solid[data-fija] + main {
    padding-top: 76px;
  }

  @media (min-width: 64rem) {
    .jk-header[data-fija] > div {
      height: 72px;
    }

    /* El desplegable arranca justo bajo la cabecera compacta */
    .jk-header[data-fija] .jk-cat-panel-inner {
      padding-top: 72px;
    }

    .jk-header-solid[data-fija] + main {
      padding-top: 150px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jk-header > div {
      transition: none;
    }
  }
</style>

<style>
  /* --- Botón hamburguesa --- */
  .jk-burger {
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Safari muestra su propio triángulo en <summary>; lo anulamos en ambos motores */
  .jk-burger::-webkit-details-marker {
    display: none;
  }

  .jk-burger::marker {
    content: "";
  }

  .jk-burger-box {
    position: relative;
    display: block;
    width: 24px;
    height: 16px;
  }

  .jk-burger-line {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 9999px;
    background-color: currentColor;
    transition:
      transform 250ms ease,
      opacity 150ms ease,
      top 250ms ease;
  }

  .jk-burger-line:nth-child(1) {
    top: 0;
  }

  .jk-burger-line:nth-child(2) {
    top: 7px;
  }

  .jk-burger-line:nth-child(3) {
    top: 14px;
  }

  /* Al abrir, las tres líneas se funden en una X */
  [data-jk-menu][open] .jk-burger-line:nth-child(1) {
    top: 7px;
    transform: rotate(45deg);
  }

  [data-jk-menu][open] .jk-burger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0.2);
  }

  [data-jk-menu][open] .jk-burger-line:nth-child(3) {
    top: 7px;
    transform: rotate(-45deg);
  }

  /* --- Cerrar sesión ---
     Sólo se muestra con sesión activa. El control por CSS evita que el
     atributo/clase `hidden` pelee con `lg:inline-flex`. */
  [data-jk-logout-escritorio],
  [data-jk-logout-movil] {
    display: none;
  }

  @media (min-width: 64rem) {
    .jk-header[data-sesion="activa"] [data-jk-logout-escritorio] {
      display: inline-flex;
    }
  }

  .jk-header[data-sesion="activa"] [data-jk-logout-movil] {
    display: flex;
  }

  /* --- Panel del menú --- */
  .jk-mobile-panel {
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    animation: jk-menu-in 200ms ease-out;
    overscroll-behavior: contain;
  }

  /* La banda que cubre la barra superior aparece con un fundido suave */
  .jk-mobile-backdrop {
    animation: jk-menu-fade 200ms ease-out;
  }

  /* Con el menú abierto la banda oscura pasa por detrás de toda la cabecera.
     Sobre el fondo claro del modo "solid" el texto negro quedaría ilegible,
     así que palabra marca y botón pasan a blanco. */
  .jk-header:has([data-jk-menu][open]) .jk-nav-ink,
  .jk-header:has([data-jk-menu][open]) .jk-burger {
    color: #fff;
  }

  .jk-header:has([data-jk-menu][open]) .jk-burger:hover {
    background-color: rgb(255 255 255 / 0.1);
  }

  @keyframes jk-menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes jk-menu-fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jk-burger-line {
      transition: none;
    }

    .jk-mobile-panel,
    .jk-mobile-backdrop {
      animation: none;
    }
  }
</style>

<script>
  // --- Sesión: acceso al panel y cierre de sesión ---
  // Con sesión activa los enlaces de login apuntan al panel y aparece el botón
  // de cerrar sesión. Sin sesión (o con localStorage bloqueado) se mantienen
  // como "Iniciar sesión".
  const accesos = document.querySelectorAll<HTMLAnchorElement>("[data-jk-login]");
  const header = document.querySelector<HTMLElement>(".jk-header");

  try {
    const token = localStorage.getItem("token");
    const usuario = JSON.parse(localStorage.getItem("user") || "null");

    if (token && usuario) {
      const esAdmin = usuario.role === "admin";
      const destino = esAdmin ? "/admin" : "/";
      const etiqueta = esAdmin ? "Panel" : "Mi cuenta";

      accesos.forEach((acceso) => {
        acceso.href = destino;
        acceso.setAttribute("aria-label", etiqueta);
        acceso.querySelector("[data-jk-login-label]")?.replaceChildren(etiqueta);
      });

      header?.setAttribute("data-sesion", "activa");
    }
  } catch {
    // localStorage bloqueado o JSON corrupto: se queda como "Iniciar sesión".
  }

  // Cerrar sesión: elimina las cookies en el servidor y la sesión local, y
  // vuelve al inicio para que nadie quede con la sesión abierta.
  document.querySelectorAll<HTMLButtonElement>("[data-jk-logout-btn]").forEach((boton) => {
    boton.addEventListener("click", async () => {
      boton.disabled = true;
      boton.setAttribute("aria-busy", "true");

      try {
        await fetch("/api/auth/logout", { method: "POST" });
      } catch {
        // Aunque falle la red, limpiamos igualmente la sesión local.
      } finally {
        localStorage.removeItem("token");
        localStorage.removeItem("user");
        window.location.href = "/";
      }
    });
  });

  // --- Menú móvil ---
  const menu = document.querySelector<HTMLDetailsElement>("[data-jk-menu]");
  const summary = menu?.querySelector<HTMLElement>("summary");

  if (menu && summary) {
    const closeMenu = (restoreFocus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (restoreFocus) summary.focus();
    };

    // Cierra al pulsar cualquier enlace (incluye anclas como /#nosotros).
    // El cierre se aplaza un frame para no interferir con la navegación
    // nativa del enlace (el <a> ya recibió el clic).
    menu.addEventListener("click", (event) => {
      if (!(event.target as HTMLElement).closest("a")) return;
      window.requestAnimationFrame(() => closeMenu());
    });

    // Cierra al hacer clic fuera del menú.
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) closeMenu();
    });

    // Escape cierra y devuelve el foco al botón.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu(true);
    });

    // Si la ventana crece hasta el layout de escritorio, el menú móvil sobra.
    const desktop = window.matchMedia("(min-width: 64rem)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) closeMenu();
    });
  }

  // --- Desplegable de categorías (escritorio) ---
  // Entre el enlace "Catálogo" y el panel se interpone la propia cabecera en el
  // hit-testing, por lo que el `:hover` CSS puro se pierde al cruzar ese hueco.
  // El script mantiene el panel abierto con `data-open` y solo lo cierra tras
  // un pequeño retardo al salir del grupo, tiempo de sobra para llegar al panel.
  document.querySelectorAll<HTMLElement>("[data-jk-cat-group]").forEach((grupo) => {
    const enlace = grupo.querySelector<HTMLAnchorElement>("[data-jk-cat-link]");
    const panel = grupo.querySelector<HTMLElement>("[data-jk-cat-panel]");
    if (!enlace || !panel) return;

    let temporizador: number | undefined;

    const abrir = () => {
      window.clearTimeout(temporizador);
      grupo.removeAttribute("data-escaping");
      grupo.setAttribute("data-open", "");
      enlace.setAttribute("aria-expanded", "true");
    };

    const cerrar = () => {
      window.clearTimeout(temporizador);
      grupo.removeAttribute("data-open");
      enlace.setAttribute("aria-expanded", "false");
    };

    grupo.addEventListener("mouseenter", abrir);

    grupo.addEventListener("mouseleave", () => {
      window.clearTimeout(temporizador);
      temporizador = window.setTimeout(cerrar, 200);
    });

    grupo.addEventListener("focusin", () => {
      // Tras Escape, el foco vuelve al enlace: no debe reabrir el panel.
      if (grupo.hasAttribute("data-escaping")) return;
      abrir();
    });

    grupo.addEventListener("focusout", (event) => {
      const destino = event.relatedTarget as Node | null;
      // El foco sigue dentro del grupo (enlace o panel): se mantiene abierto.
      if (destino && grupo.contains(destino)) return;
      grupo.removeAttribute("data-escaping");
      cerrar();
    });

    grupo.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      // Cierra el panel y devuelve el foco al enlace "Catálogo". El atributo
      // data-escaping evita que :focus-within lo reabra en el acto.
      event.stopPropagation();
      grupo.setAttribute("data-escaping", "");
      cerrar();
      enlace.focus();
    });
  });

  // --- Cabecera fija al hacer scroll ---
  // Solo alterna `data-fija` en el <header> (umbral de 80px), con listener
  // pasivo y sin re-render: el estado se cachea para no tocar el DOM en cada
  // evento. Todo vive en el script de cliente, nunca en el frontmatter.
  if (header) {
    const UMBRAL_FIJO = 80;
    let fija = false;

    const aplicarCabecera = () => {
      const debeFijarse = window.scrollY > UMBRAL_FIJO;
      if (debeFijarse === fija) return;
      fija = debeFijarse;
      if (fija) header.setAttribute("data-fija", "");
      else header.removeAttribute("data-fija");
    };

    window.addEventListener("scroll", aplicarCabecera, { passive: true });
    aplicarCabecera();
  }
</script>
