---
import { Image } from "astro:assets";
import type { Product } from "../lib/types";
import { proxyImageUrl } from "../lib/images";
import { descuentoAplicable, formatPrice, precioConDescuento, precioTexto } from "../lib/precio";

interface Props {
  product: Product;
  /** Ruta del catálogo (con sus filtros) para volver desde la ficha. */
  volver?: string;
  /** Ancho de la tarjeta en píxeles; base del `srcset` (ver `ProductGrid`). */
  anchoTarjeta?: number;
  /** Atributo `sizes` que acompaña a ese ancho. */
  sizes?: string;
}

const { product, volver, anchoTarjeta = 381, sizes } = Astro.props;

// Enlace a la ficha: si viene `volver`, se adjunta la ruta del catálogo con un
// `destacar` para que al regresar quede a la vista esta tarjeta. Se limpia un
// `destacar` previo para no acumularlo al navegar entre productos.
let hrefProducto = `/products/${product._id}`;

if (volver) {
  const urlVolver = new URL(volver, "http://localhost");
  urlVolver.searchParams.delete("destacar");
  urlVolver.searchParams.set("destacar", product._id);
  const volverConDestacar = `${urlVolver.pathname}${urlVolver.search}`;
  hrefProducto += `?volver=${encodeURIComponent(volverConDestacar)}`;
}

const imageUrl = proxyImageUrl(product.images[0]);
// La foto original pesa ~150 KB y mide ~940x1050 px, pero aquí se pinta en una
// caja de 369x491 (~0,18 MP frente a ~1 MP). `<Image>` la recorta a la
// proporción de la caja y la reduce, y sirve WebP con `srcset` para que el
// navegador baje el tamaño que va a usar: medido, 178 KB -> 25 KB por tarjeta.
// El archivo original no se toca, así que WhatsApp (que solo admite JPEG y
// PNG) sigue enviando el maestro intacto.
const proporcion = "369 / 491";
const ancho2x = anchoTarjeta * 2;
const sizesImagen = sizes ?? `(min-width: 1024px) ${anchoTarjeta}px, (min-width: 640px) 45vw, 90vw`;
// La miniatura del carrito se pinta a 64 px (`CarritoUI.tsx`), y el panel la
// pide a 48 px, pero ambas usaban la foto completa. Se les da una versión de
// 128 px (2x de 64) por el mismo endpoint de Astro, que además la devuelve
// WebP: de ~150 KB a ~4 KB.
const imagenCarrito = imageUrl
  ? imageUrl.startsWith("/_image")
    ? imageUrl
    : `/_image?href=${encodeURIComponent(imageUrl)}&w=128&h=170&f=webp`
  : "";
const descuento = descuentoAplicable(product.discountPercent);
const tieneDescuento = descuento > 0 && product.price > 0;
const precioFinal = precioConDescuento(product.price, product.discountPercent);
// Con descuento aplicado un precio final de 0 es un precio real ($ 0), no una
// cotización: "Cotización" se reserva para productos sin precio (price <= 0).
const precioFinalTexto = tieneDescuento ? formatPrice(precioFinal) : precioTexto(product.price);

// Swatches de colores: se muestran como máximo 6 círculos; si hay más, el
// último hueco es un indicador "+N". La fila solo se pinta si el producto
// tiene colores, así las tarjetas actuales (colors: []) no cambian.
const MAX_COLORES_VISIBLES = 6;
const colores = product.colors ?? [];
const coloresVisibles = colores.slice(0, MAX_COLORES_VISIBLES);
const coloresRestantes = colores.slice(MAX_COLORES_VISIBLES);
const nombresColores = colores.map((color) => color.name).join(", ");
---

<div id={`producto-${product._id}`} class="group relative scroll-mt-28">
  <a href={hrefProducto} class="block">
    <div
      class="aspect-[369/491] overflow-hidden rounded-[4px] border border-jk-gold bg-jk-mist"
      style={`aspect-ratio: ${proporcion}`}
    >
      {
        imageUrl ? (
          <Image
            src={imageUrl}
            alt={product.name}
            width={anchoTarjeta}
            height={491}
            widths={[anchoTarjeta, ancho2x]}
            sizes={sizesImagen}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          />
        ) : null
      }
    </div>
    <div class="mt-2 flex items-start justify-between gap-3">
      <h2 class="font-sans text-[16px] font-medium text-jk-ink">{product.name}</h2>
      {
        tieneDescuento ? (
          <span class="flex shrink-0 flex-col items-end">
            <span class="font-sans text-[16px] font-semibold text-jk-gold-deep">
              {precioFinalTexto}
            </span>
            <span class="mt-0.5 flex items-center gap-1.5">
              <span class="font-sans text-[13px] text-jk-gold-muted line-through">
                <span class="sr-only">Precio original: </span>
                {precioTexto(product.price)}
              </span>
              <span class="rounded-full bg-jk-gold-deep px-1.5 py-0.5 font-sans text-[11px] font-semibold leading-none text-white">
                <span class="sr-only">Descuento del </span>-{descuento} %
              </span>
            </span>
          </span>
        ) : (
          <span class="shrink-0 font-sans text-[16px] font-medium text-jk-ink">
            {precioTexto(product.price)}
          </span>
        )
      }
    </div>
    {
      colores.length > 0 && (
        <ul
          class="mt-1.5 flex items-center gap-1.5"
          aria-label={`Colores disponibles: ${nombresColores}`}
        >
          {coloresVisibles.map((color) => (
            <li
              class="h-4 w-4 shrink-0 rounded-full border border-jk-mist"
              style={`background-color: ${color.hex}`}
              title={color.name}
            >
              <span class="sr-only">{color.name}</span>
            </li>
          ))}
          {coloresRestantes.length > 0 && (
            <li
              class="flex h-4 items-center font-sans text-[12px] leading-none text-jk-gold-muted"
              title={`También en: ${coloresRestantes.map((color) => color.name).join(", ")}`}
            >
              <span aria-hidden="true">+{coloresRestantes.length}</span>
              <span class="sr-only">
                {` y ${coloresRestantes.length} ${coloresRestantes.length === 1 ? "color más" : "colores más"}: ${coloresRestantes.map((color) => color.name).join(", ")}`}
              </span>
            </li>
          )}
        </ul>
      )
    }
  </a>

  <!-- Botón rápido: agrega sin variante; el widget del carrito lee el dataset -->
  <button
    type="button"
    data-agregar-carrito
    data-product-id={product._id}
    data-nombre={product.name}
    data-categoria={product.category}
    data-precio={precioFinal > 0 ? String(precioFinal) : ""}
    data-imagen={imagenCarrito}
    aria-label={`Agregar ${product.name} al carrito`}
    class="absolute right-3 top-3 z-10 flex h-11 w-11 items-center justify-center rounded-full border border-jk-gold bg-black/70 text-white backdrop-blur-sm transition-colors hover:bg-jk-gold hover:text-jk-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-jk-gold"
  >
    <span
      data-jk-carrito-label
      data-agregado="✓"
      aria-hidden="true"
      class="text-[20px] leading-none"
    >
      +
    </span>
  </button>
</div>

<style>
  /* Resaltado temporal de la tarjeta al volver de la ficha (lo activa el
     script del catálogo). El outline añade una pista visible que no depende
     solo del color y no provoca saltos de layout. */
  .jk-producto-destacado {
    outline: 3px solid var(--color-jk-gold);
    outline-offset: 4px;
    border-radius: 6px;
  }
</style>
