---
import type { Product } from "../lib/types";
import { proxyImageUrl } from "../lib/images";
import { precioTexto } from "../lib/precio";

interface Props {
  product: Product;
}

const { product } = Astro.props;

const imageUrl = proxyImageUrl(product.images[0]);
---

<a href={`/products/${product._id}`} class="group block">
  <div class="aspect-[369/491] overflow-hidden rounded-[4px] border border-jk-gold bg-jk-mist">
    {
      imageUrl ? (
        <img
          src={imageUrl}
          alt={product.name}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : null
    }
  </div>
  <div class="mt-2 flex items-start justify-between gap-3">
    <h2 class="font-sans text-[16px] font-medium text-jk-ink">{product.name}</h2>
    <span class="shrink-0 font-sans text-[16px] font-medium text-jk-ink">
      {precioTexto(product.price)}
    </span>
  </div>
</a>
