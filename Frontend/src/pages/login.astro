---
import Layout from "../layouts/Layout.astro";

// El mensaje llega por query string cuando el formulario se envía sin JS
// (la ruta /api/auth/login redirige de vuelta con ?error=).
const error = Astro.url.searchParams.get("error");
---

<Layout title="Iniciar Sesión" bodyClass="bg-jk-surface text-jk-ink">
  <div class="mx-auto flex min-h-[80vh] max-w-[1440px] items-center justify-center px-5 py-16">
    <div class="w-full max-w-md">
      <div
        class="overflow-hidden rounded-[10px] border border-jk-gold/60 bg-white shadow-[0px_18px_45px_-20px_rgba(98,93,74,0.35)]"
      >
        <div class="jk-card-bar h-1.5 w-full" aria-hidden="true"></div>

        <div class="p-8 lg:p-10">
          <header class="text-center">
            <p class="font-brand text-[26px] font-medium tracking-[-0.25px] text-jk-ink">
              JK Mobiliario
            </p>
            <h1 class="mt-4 font-sans text-[22px] font-semibold text-jk-ink">Iniciar sesión</h1>
            <p class="mt-1 font-sans text-[14px] text-jk-gold-deep">
              Accede al panel de administración.
            </p>
          </header>

          <div
            id="error-message"
            role="alert"
            class:list={[
              "mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 font-sans text-[13px] text-red-700",
              !error && "hidden",
            ]}
          >
            {error}
          </div>

          <form id="login-form" action="/api/auth/login" method="post" class="mt-6 space-y-5">
            <div>
              <label for="email" class="mb-1.5 block font-sans text-[13px] font-medium text-jk-ink">
                Correo electrónico
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="username"
                placeholder="tu@email.com"
                class="w-full rounded-lg border border-jk-mist bg-white px-4 py-2.5 font-sans text-[15px] text-jk-ink outline-none transition-colors placeholder:text-jk-gold-muted focus:border-jk-gold-deep focus:ring-2 focus:ring-jk-gold-deep/40"
              />
            </div>

            <div>
              <label
                for="password"
                class="mb-1.5 block font-sans text-[13px] font-medium text-jk-ink"
              >
                Contraseña
              </label>
              <div class="relative">
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••"
                  class="w-full rounded-lg border border-jk-mist bg-white px-4 py-2.5 pr-12 font-sans text-[15px] text-jk-ink outline-none transition-colors placeholder:text-jk-gold-muted focus:border-jk-gold-deep focus:ring-2 focus:ring-jk-gold-deep/40"
                />
                <button
                  type="button"
                  id="toggle-password"
                  aria-pressed="false"
                  aria-label="Mostrar contraseña"
                  class="absolute right-2 top-1/2 -translate-y-1/2 rounded-md p-2 text-jk-gold-deep transition-colors hover:bg-jk-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-jk-gold-deep"
                >
                  <svg
                    id="icon-eye"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z"
                    ></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  <svg
                    id="icon-eye-off"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="hidden h-5 w-5"
                    aria-hidden="true"
                  >
                    <path d="M3 3l18 18"></path>
                    <path d="M10.6 5.8A9.6 9.6 0 0 1 12 5.7c6 0 9.5 6.3 9.5 6.3a17 17 0 0 1-3 3.6"
                    ></path>
                    <path d="M6.2 6.9A16.7 16.7 0 0 0 2.5 12S6 18.3 12 18.3a9.4 9.4 0 0 0 4.1-.9"
                    ></path>
                    <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
                  </svg>
                </button>
              </div>
            </div>

            <button
              id="login-submit"
              type="submit"
              class="jk-btn-gradient flex w-full items-center justify-center gap-2 rounded-lg py-3 font-label text-[16px] font-medium text-jk-ink transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-jk-gold-deep disabled:cursor-not-allowed disabled:opacity-60"
            >
              <svg
                id="login-spinner"
                class="hidden h-4 w-4 animate-spin"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
                ></path>
              </svg>
              <span id="login-submit-label">Ingresar</span>
            </button>
          </form>

          <p class="mt-6 text-center font-sans text-[13px] text-jk-gold-deep">
            ¿Problemas para entrar? Contacta al administrador.
          </p>
        </div>
      </div>

      <p class="mt-6 text-center">
        <a
          href="/"
          class="font-sans text-[13px] text-jk-gold-deep underline-offset-4 transition-colors hover:text-jk-ink hover:underline"
          >← Volver al inicio</a
        >
      </p>
    </div>
  </div>

  <script>
    const form = document.getElementById("login-form") as HTMLFormElement;
    const errorDiv = document.getElementById("error-message") as HTMLDivElement;
    const submitBtn = document.getElementById("login-submit") as HTMLButtonElement;
    const submitLabel = document.getElementById("login-submit-label") as HTMLSpanElement;
    const spinner = document.getElementById("login-spinner") as HTMLElement;
    const emailInput = document.getElementById("email") as HTMLInputElement;
    const passwordInput = document.getElementById("password") as HTMLInputElement;
    const toggle = document.getElementById("toggle-password") as HTMLButtonElement;
    const eye = document.getElementById("icon-eye") as HTMLElement;
    const eyeOff = document.getElementById("icon-eye-off") as HTMLElement;

    const setLoading = (loading: boolean) => {
      submitBtn.disabled = loading;
      submitBtn.setAttribute("aria-busy", String(loading));
      submitLabel.textContent = loading ? "Ingresando…" : "Ingresar";
      spinner.classList.toggle("hidden", !loading);
    };

    // Mostrar / ocultar contraseña sin perder el valor ni el foco.
    toggle.addEventListener("click", () => {
      const estabaOculta = passwordInput.type === "password";
      passwordInput.type = estabaOculta ? "text" : "password";
      toggle.setAttribute("aria-pressed", String(estabaOculta));
      toggle.setAttribute("aria-label", estabaOculta ? "Ocultar contraseña" : "Mostrar contraseña");
      eye.classList.toggle("hidden", estabaOculta);
      eyeOff.classList.toggle("hidden", !estabaOculta);
      passwordInput.focus();
    });

    form.addEventListener("submit", async (e) => {
      // Con JS interceptamos para no recargar; sin JS el formulario viaja
      // igual a /api/auth/login (action + method) y redirige desde el servidor.
      e.preventDefault();
      errorDiv.classList.add("hidden");
      errorDiv.textContent = "";
      setLoading(true);

      try {
        const res = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: emailInput.value.trim(),
            password: passwordInput.value,
          }),
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.message || "Credenciales incorrectas");
        }

        localStorage.setItem("token", data.data.token);
        localStorage.setItem("user", JSON.stringify(data.data.user));

        // El admin entra al panel completo; el trabajador, a la revisión de
        // comprobantes, que es lo único que puede ver.
        const rol = data.data.user.role;
        window.location.href =
          rol === "admin" ? "/admin" : rol === "trabajador" ? "/admin/comprobantes" : "/";
      } catch (err) {
        errorDiv.textContent = err instanceof Error ? err.message : "Error al iniciar sesión";
        errorDiv.classList.remove("hidden");
        setLoading(false);
      }
    });
  </script>
</Layout>
