---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import CambioPassword from "../components/react/auth/CambioPassword";

const token = Astro.cookies.get("token")?.value;
if (!token) {
  return Astro.redirect("/login");
}

// Esta pantalla no la cubre el middleware (solo guarda /admin), así que el
// guard completo vive aquí: sin sesión válida no se pinta el formulario.
//
// AQUÍ SOLO SE COMPRUEBA QUE HAYA SESIÓN, no en qué estado está. La decisión de
// "ya cambió su contraseña, no tiene nada que hacer aquí" la toma la isla, y es
// a propósito: el servidor solo ve la cookie, pero las llamadas a la API salen
// con el token de `localStorage`. Si el servidor decidiera con la cookie y la
// isla con `localStorage`, dos copias de la misma sesión podrían discrepar y
// mandarse la una a la otra sin fin — un bucle de redirecciones del que el
// usuario no puede salir. Decidiendo con el mismo token que se usa para llamar,
// la discrepancia no puede producirse.
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4000";
try {
  const res = await fetch(`${API_URL}/api/auth/profile`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (!res.ok) return Astro.redirect("/login");
} catch {
  return Astro.redirect("/login");
}
---

<Layout title="Cambiar contraseña" bodyClass="bg-jk-surface text-jk-ink">
  <div class="mx-auto flex min-h-[80vh] max-w-[1440px] items-center justify-center px-5 py-16">
    <CambioPassword client:load />
  </div>
</Layout>
