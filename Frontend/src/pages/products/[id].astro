---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import ImageGallery from "../../components/ImageGallery.astro";
import ProductOptions from "../../components/react/ProductOptions";
import { getProductById } from "../../lib/api";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}

let product = null;
let error = null;

try {
  product = await getProductById(id);
} catch (e) {
  error = e instanceof Error ? e.message : "Error al cargar el producto";
}
---

<Layout title={product?.name || "Producto"}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {error ? (
      <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
        <p class="text-red-700">{error}</p>
        <a href="/" class="mt-4 inline-block text-blue-600 hover:underline">Volver al catálogo</a>
      </div>
    ) : product && (
      <div class="mb-4">
        <a href="/" class="text-sm text-gray-500 hover:text-gray-700">← Volver al catálogo</a>
      </div>
    )}

    {product && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <ImageGallery images={product.images} name={product.name} />

        <div class="space-y-6">
          <div>
            <p class="text-sm text-gray-500 uppercase tracking-wide mb-2">{product.category}</p>
            <h1 class="text-2xl lg:text-3xl font-bold text-gray-900">{product.name}</h1>
          </div>

          <ProductOptions product={product} client:load />

          <div class="pt-4 border-t">
            <h3 class="text-sm font-medium text-gray-900 mb-2">Descripción</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{product.description}</p>
          </div>

          <div class="pt-4 border-t">
            <h3 class="text-sm font-medium text-gray-900 mb-2">Dimensiones</h3>
            <p class="text-gray-600 text-sm">{product.dimensions}</p>
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>
