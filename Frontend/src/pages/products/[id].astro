---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import ImageGallery from "../../components/ImageGallery.astro";
import ProductOptions from "../../components/react/ProductOptions";
import Visor3D from "../../components/react/Visor3D";
import { getProductById } from "../../lib/api";
import { proxyModelUrl } from "../../lib/modelos";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/");
}

let product = null;
let error = null;

try {
  product = await getProductById(id);
} catch (e) {
  error = e instanceof Error ? e.message : "Error al cargar el producto";
}

// El backend expone `model3d` (URL del GLB) y `medidasBase` (medidas reales en
// cm del modelo). Sin `model3d`, la sección "Vista 3D" muestra el placeholder.
const modelo = product?.model3d
  ? { url: proxyModelUrl(product.model3d), medidasBase: product.medidasBase }
  : undefined;
---

<Layout title={product?.name || "Producto"} bodyClass="bg-jk-surface text-jk-ink">
  <div class="mx-auto max-w-[1440px] px-5 py-10 lg:px-[131px]">
    {error ? (
      <div class="rounded-lg border border-jk-gold bg-white p-6 text-center">
        <p class="text-red-700">{error}</p>
        <a href="/catalogo" class="mt-4 inline-block text-jk-gold-deep hover:underline"
          >Volver al catálogo</a
        >
      </div>
    ) : (
      product && (
        <div class="mb-6">
          <a
            href="/catalogo"
            class="font-sans text-[15px] text-jk-gold-deep hover:underline"
            >← Volver al catálogo</a
          >
        </div>
      )
    )}

    {
      product && (
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
          <ImageGallery images={product.images} name={product.name} />

          <div class="space-y-6">
            <div>
              <p class="mb-2 font-sans text-[14px] uppercase tracking-wide text-jk-gold-muted">
                {product.category}
              </p>
              <h1 class="font-sans text-[28px] font-bold lg:text-[36px]">{product.name}</h1>
            </div>

            <ProductOptions product={product} client:load />

            <div class="border-t border-jk-gold/40 pt-4">
              <h2 class="mb-2 font-sans text-[16px] font-semibold">Descripción</h2>
              <p class="font-sans text-[15px] leading-relaxed text-[#49454F]">
                {product.description}
              </p>
            </div>

            <div class="border-t border-jk-gold/40 pt-4">
              <h2 class="mb-2 font-sans text-[16px] font-semibold">Dimensiones</h2>
              <p class="font-sans text-[15px] text-[#49454F]">{product.dimensions}</p>
            </div>
          </div>
        </div>
      )
    }

    {
      product && (
        <section id="vista-3d" class="mt-16 border-t border-jk-gold/40 pt-8">
          <h2 class="font-sans text-[20px] font-semibold lg:text-[24px]">Vista 3D</h2>
          <p class="mt-1 font-sans text-[15px] text-[#49454F]">
            Gíralo, acércalo y personaliza el color del acabado en tiempo real.
          </p>

          {modelo ? (
            <Visor3D
              client:visible
              modelUrl={modelo.url}
              medidasBase={modelo.medidasBase}
              colores={product.colors}
              nombre={product.name}
            />
          ) : (
            <div class="mt-6 flex aspect-[16/9] w-full items-center justify-center rounded-[4px] border border-jk-gold bg-jk-mist">
              <p class="px-6 text-center font-sans text-[14px] text-jk-gold-deep">
                Vista 3D disponible próximamente para este producto.
              </p>
            </div>
          )}
        </section>
      )
    }
  </div>
</Layout>
