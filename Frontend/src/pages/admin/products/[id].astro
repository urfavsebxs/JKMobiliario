---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import ProductForm from "../../../components/react/ProductForm";
import { getProductById } from "../../../lib/api";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin");
}

const token = Astro.cookies.get("token")?.value;
if (!token) {
  return Astro.redirect("/login");
}

let product = null;
let error = null;

try {
  product = await getProductById(id);
} catch (e) {
  error = e instanceof Error ? e.message : "Error al cargar el producto";
}
---

<Layout title={product ? `Editar ${product.name}` : "Editar Producto"}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <a href="/admin" class="text-sm text-gray-500 hover:text-gray-700">← Volver al panel</a>
    </div>

    {error ? (
      <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
        <p class="text-red-700">{error}</p>
      </div>
    ) : product && (
      <div class="bg-white rounded-lg shadow p-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-6">Editar Producto</h1>
        <ProductForm client:load productId={product._id} product={product} />
      </div>
    )}
  </div>
</Layout>
