---
export const prerender = false;

import Layout from "../../../layouts/Layout.astro";
import ProductForm from "../../../components/react/ProductForm";
---

<Layout title="Nuevo Producto">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-6">
      <a href="/admin" class="text-sm text-gray-500 hover:text-gray-700">← Volver al panel</a>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <h1 class="text-2xl font-bold text-gray-900 mb-6">Nuevo Producto</h1>
      <ProductForm client:load />
    </div>
  </div>
</Layout>
