---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import AdminClientes from "../../components/react/admin/AdminClientes";

const token = Astro.cookies.get("token")?.value;
if (!token) {
  return Astro.redirect("/login");
}

// El middleware ya saca a los trabajadores de aquí (`/admin/clientes` no está
// en RUTAS_TRABAJADOR), pero se vuelve a comprobar: esta pantalla muestra el
// teléfono y las notas privadas de los clientes, y no debe depender solo del
// middleware.
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4000";
let rol = "";
try {
  const res = await fetch(`${API_URL}/api/auth/profile`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (!res.ok) return Astro.redirect("/login");
  rol = (await res.json()).data?.role ?? "";
} catch {
  return Astro.redirect("/login");
}

if (rol !== "admin") {
  return Astro.redirect("/");
}
---

<Layout title="Clientes" bodyClass="bg-jk-surface text-jk-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <a href="/admin" class="text-sm text-gray-500 hover:text-gray-700">
        ← Volver al panel
      </a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1">Clientes</h1>
      <p class="text-gray-600">
        Lo que el asesor recuerda de cada persona que le escribe: su nombre, lo último que compró y
        si tenía un reclamo abierto. Se llena solo con cada conversación de WhatsApp.
      </p>
    </div>

    <AdminClientes client:load />
  </div>
</Layout>
