---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import AdminUsuarios from "../../components/react/admin/AdminUsuarios";

const token = Astro.cookies.get("token")?.value;
if (!token) {
  return Astro.redirect("/login");
}

// El middleware ya filtra por rol, pero se vuelve a comprobar aquí (defensa en
// profundidad): esta pantalla reparte credenciales de acceso al panel.
const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:4000";
let rol = "";
try {
  const res = await fetch(`${API_URL}/api/auth/profile`, {
    headers: { Authorization: `Bearer ${token}` },
  });
  if (!res.ok) return Astro.redirect("/login");
  rol = (await res.json()).data?.role ?? "";
} catch {
  return Astro.redirect("/login");
}

if (rol !== "admin") {
  return Astro.redirect("/");
}
---

<Layout title="Usuarios" bodyClass="bg-jk-surface text-jk-ink">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
      <a href="/admin" class="text-sm text-gray-500 hover:text-gray-700">← Volver al panel</a>
      <h1 class="text-2xl font-bold text-gray-900 mt-1">Usuarios</h1>
      <p class="text-gray-600">
        Crea las cuentas del equipo y entrega las credenciales en mano. Cada persona cambia su
        contraseña temporal la primera vez que entra.
      </p>
    </div>

    <AdminUsuarios client:load />
  </div>
</Layout>
