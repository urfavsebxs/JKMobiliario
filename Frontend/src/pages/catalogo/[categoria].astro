---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import FiltrosCatalogo from "../../components/site/FiltrosCatalogo.astro";
import Paginacion from "../../components/site/Paginacion.astro";
import PanelCategorias from "../../components/site/PanelCategorias.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import { getAllProducts } from "../../lib/api";
import { CATEGORIAS_POR_DEFECTO, normalizarCategoria } from "../../lib/categorias";
import {
  cumpleMedidas,
  normalizarLimitesMedidas,
  numeroDeParametro,
  tieneLimitesMedidas,
} from "../../lib/medidasProducto";
import type { Product } from "../../lib/types";

const categoria = decodeURIComponent(Astro.params.categoria ?? "");
const busqueda = (Astro.url.searchParams.get("q") || "").trim();

// Filtro de medidas por ancho y largo (en cm); cada límite vacío se ignora.
// `normalizarLimitesMedidas` descarta negativos e invierte rangos invertidos.
const anchoMin = (Astro.url.searchParams.get("anchoMin") || "").trim();
const anchoMax = (Astro.url.searchParams.get("anchoMax") || "").trim();
const largoMin = (Astro.url.searchParams.get("largoMin") || "").trim();
const largoMax = (Astro.url.searchParams.get("largoMax") || "").trim();

const limites = normalizarLimitesMedidas({
  anchoMin: numeroDeParametro(anchoMin),
  anchoMax: numeroDeParametro(anchoMax),
  largoMin: numeroDeParametro(largoMin),
  largoMax: numeroDeParametro(largoMax),
});

let productos: Product[] = [];
try {
  productos = await getAllProducts();
} catch {
  productos = [];
}

// `normalizarCategoria` (lib compartida) hace que el slug de la URL coincida
// con el dato guardado aunque la BD use acentos, guiones o mayúsculas.
const categoriaNormalizada = normalizarCategoria(categoria);

/**
 * "Otros" funciona como cajón: además de los productos con categoría "Otros",
 * incluye los que no encajan en ninguna de las categorías predeterminadas.
 */
const CATEGORIAS_PREDEFINIDAS = new Set(
  CATEGORIAS_POR_DEFECTO.map((predefinida) => normalizarCategoria(predefinida.name))
);
const esCajonOtros = categoriaNormalizada === "otros";

const filtrados = productos.filter((p) => {
  const categoriaProducto = normalizarCategoria(p.category ?? "");

  if (esCajonOtros) {
    if (categoriaProducto !== "otros" && CATEGORIAS_PREDEFINIDAS.has(categoriaProducto)) {
      return false;
    }
  } else if (!categoriaProducto.includes(categoriaNormalizada)) {
    return false;
  }

  if (busqueda) {
    // Normaliza ambos lados (sin acentos, mayúsculas ni guiones) e indexa
    // también sizes/dimensions para poder buscar por medidas ("1.90").
    const texto = normalizarCategoria(
      [
        p.name,
        p.description ?? "",
        p.category ?? "",
        (p.sizes ?? []).join(" "),
        p.dimensions ?? "",
      ].join(" ")
    );
    if (!texto.includes(normalizarCategoria(busqueda))) return false;
  }

  if (!cumpleMedidas(p, limites)) return false;

  return true;
});

// Aviso de vacío por medidas (no se distingue de otros filtros: basta con que
// haya límites informados y la lista quede vacía).
const sinResultadosMedidas = filtrados.length === 0 && tieneLimitesMedidas(limites);

// ─── Paginación ──────────────────────────────────────────────────────
/** Productos por página del catálogo. */
const PAGE_SIZE = 12;

const totalFiltrados = filtrados.length;
const totalPaginas = Math.max(1, Math.ceil(totalFiltrados / PAGE_SIZE));

// Página fuera de rango o inválida: se ajusta a 1 o a la última sin errores.
const paginaSolicitada = numeroDeParametro(Astro.url.searchParams.get("pagina"));
const pagina = Math.min(
  Math.max(1, paginaSolicitada === null ? 1 : Math.floor(paginaSolicitada)),
  totalPaginas
);

const productosPagina = filtrados.slice((pagina - 1) * PAGE_SIZE, pagina * PAGE_SIZE);
const desde = totalFiltrados === 0 ? 0 : (pagina - 1) * PAGE_SIZE + 1;
const hasta = Math.min(pagina * PAGE_SIZE, totalFiltrados);

// Filtros activos para los enlaces del paginador (la categoría va en la ruta).
const parametrosPaginacion: Record<string, string> = {};
if (busqueda) parametrosPaginacion.q = busqueda;
if (anchoMin) parametrosPaginacion.anchoMin = anchoMin;
if (anchoMax) parametrosPaginacion.anchoMax = anchoMax;
if (largoMin) parametrosPaginacion.largoMin = largoMin;
if (largoMax) parametrosPaginacion.largoMax = largoMax;

const whatsapp = import.meta.env.PUBLIC_WHATSAPP_NUMBER || "";
const waMedidasHref = whatsapp
  ? `https://wa.me/${whatsapp}?text=${encodeURIComponent("Hola, busco un producto con medidas específicas.")}`
  : "/#contacto";
---

<Layout title={categoria} navMode="overlay" bodyClass="bg-jk-surface text-jk-ink">
  <!-- Cabecera oscura con el panel de subcategorías -->
  <section class="relative overflow-hidden bg-black">
    <img
      src="/images/jk/hero.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-[0.35]"
    />
    <div
      class="relative mx-auto max-w-[1440px] px-5 pt-16 pb-12 lg:px-[166px] lg:pt-[115px] lg:pb-[57px]"
    >
      <h1 class="sr-only">{categoria}</h1>
      <PanelCategorias activa={categoria} />
    </div>
  </section>

  <div class="mx-auto max-w-[1440px] px-5 pb-24 lg:px-[131px] lg:pb-[201px]">
    <FiltrosCatalogo
      busqueda={busqueda}
      anchoMin={anchoMin}
      anchoMax={anchoMax}
      largoMin={largoMin}
      largoMax={largoMax}
    />

    <div class="mt-[72px]">
      {sinResultadosMedidas && (
        <div class="mb-10 rounded-[10px] border border-jk-gold bg-jk-cream px-5 py-4 font-sans text-[16px] leading-[1.5] text-jk-ink">
          <p>
            No encontramos productos con esas medidas publicadas. Muchos se
            fabrican a la medida:
            <a
              href={waMedidasHref}
              target={whatsapp ? "_blank" : undefined}
              rel={whatsapp ? "noopener noreferrer" : undefined}
              class="font-medium underline transition-opacity hover:opacity-70"
            >
              escríbenos por WhatsApp
            </a>.
          </p>
        </div>
      )}

      <ProductGrid products={productosPagina} />

      <Paginacion
        pagina={pagina}
        totalPaginas={totalPaginas}
        total={totalFiltrados}
        desde={desde}
        hasta={hasta}
        ruta={Astro.url.pathname}
        parametros={parametrosPaginacion}
      />
    </div>
  </div>
</Layout>
