---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import FiltrosCatalogo from "../../components/site/FiltrosCatalogo.astro";
import PanelCategorias from "../../components/site/PanelCategorias.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import { getProducts } from "../../lib/api";
import type { Product } from "../../lib/types";

const categoria = decodeURIComponent(Astro.params.categoria ?? "");
const busqueda = (Astro.url.searchParams.get("q") || "").trim();
const medidaMin = (Astro.url.searchParams.get("min") || "").trim();
const medidaMax = (Astro.url.searchParams.get("max") || "").trim();

let productos: Product[] = [];
try {
  const { products } = await getProducts(1, 100);
  productos = products;
} catch {
  productos = [];
}

const numerosDe = (p: Product) =>
  [p.dimensions, ...p.sizes]
    .join(" ")
    .match(/\d+(?:[.,]\d+)?/g)
    ?.map((n) => Number(n.replace(",", "."))) ?? [];

/**
 * Normaliza el texto de categorías para que el slug de la URL coincida con el
 * dato guardado: minúsculas, sin acentos y guiones convertidos en espacios
 * ("centros-de-tv" → "centros de tv", "Sofás" → "sofas").
 */
const normalizar = (texto: string) =>
  texto
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[-_]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const categoriaNormalizada = normalizar(categoria);

const min = medidaMin ? Number(medidaMin) : null;
const max = medidaMax ? Number(medidaMax) : null;

const filtrados = productos.filter((p) => {
  if (!normalizar(p.category ?? "").includes(categoriaNormalizada)) return false;

  if (busqueda) {
    const texto = `${p.name} ${p.description ?? ""} ${p.category ?? ""}`.toLowerCase();
    if (!texto.includes(busqueda.toLowerCase())) return false;
  }

  if (min !== null || max !== null) {
    const medidas = numerosDe(p);
    if (!medidas.some((n) => (min === null || n >= min) && (max === null || n <= max)))
      return false;
  }

  return true;
});
---

<Layout title={categoria} navMode="overlay" bodyClass="bg-jk-surface text-jk-ink">
  <!-- Cabecera oscura con el panel de subcategorías -->
  <section class="relative overflow-hidden bg-black">
    <img
      src="/images/jk/hero.jpg"
      alt=""
      class="absolute inset-0 h-full w-full object-cover opacity-[0.35]"
    />
    <div
      class="relative mx-auto max-w-[1440px] px-5 pt-16 pb-12 lg:px-[166px] lg:pt-[115px] lg:pb-[57px]"
    >
      <h1 class="sr-only">{categoria}</h1>
      <PanelCategorias />
    </div>
  </section>

  <div class="mx-auto max-w-[1440px] px-5 pb-24 lg:px-[131px] lg:pb-[201px]">
    <FiltrosCatalogo
      busqueda={busqueda}
      medidaMin={medidaMin}
      medidaMax={medidaMax}
    />

    <div class="mt-[72px]">
      <ProductGrid products={filtrados} />
    </div>
  </div>
</Layout>
