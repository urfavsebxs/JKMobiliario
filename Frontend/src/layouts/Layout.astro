---
import Nav from "../components/site/Nav.astro";
import Footer from "../components/site/Footer.astro";
import AsesorIA from "../components/react/AsesorIA.tsx";
import CarritoUI from "../components/react/CarritoUI.tsx";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  navMode?: "overlay" | "solid";
  /** Fuerza el wordmark a tinta plana (fondos claros donde el dorado no
   *  contrasta). Por defecto va bicolor en todo el sitio. */
  wordmarkPlano?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = "Diseño y mobiliario de alta gama pensado para crear ambientes únicos.",
  navMode = "solid",
  wordmarkPlano = false,
  bodyClass = "bg-black text-white",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Kapakana&family=Playfair+Display:wght@500&family=Sofia+Sans+Semi+Condensed:wght@300;500;700&family=Inclusive+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | JK Mobiliario</title>
  </head>
  <body class={bodyClass}>
    <Nav mode={navMode} wordmarkPlano={wordmarkPlano} />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Asesor IA y carrito: islas diferidas para no afectar los Core Web Vitals. -->
    <AsesorIA client:idle />
    <CarritoUI client:idle />
  </body>
</html>
