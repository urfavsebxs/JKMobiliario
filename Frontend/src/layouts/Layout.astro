---
import CartButton from "../components/react/CartButton";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tienda de muebles de calidad" } = Astro.props;
const userCookie = Astro.cookies.get("user")?.value;
const currentUser = userCookie ? JSON.parse(userCookie) : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | JKMobiliario</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="text-xl font-bold text-gray-900">JKMobiliario</a>
          <div class="flex items-center gap-6">
            <a href="/" class="text-gray-600 hover:text-gray-900 transition-colors">Productos</a>
            {currentUser?.role === "admin" && (
              <a href="/admin" class="text-gray-600 hover:text-gray-900 transition-colors">Admin</a>
            )}
            {currentUser ? (
              <div class="flex items-center gap-4">
                <span class="text-sm text-gray-600">{currentUser.name}</span>
                <button
                  id="logout-btn"
                  class="text-gray-600 hover:text-gray-900 transition-colors text-sm"
                >
                  Salir
                </button>
              </div>
            ) : (
              <a href="/login" class="text-gray-600 hover:text-gray-900 transition-colors">Iniciar Sesión</a>
            )}
            <CartButton client:load />
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-white border-t mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <p class="text-center text-gray-500 text-sm">&copy; {new Date().getFullYear()} JKMobiliario. Todos los derechos reservados.</p>
      </div>
    </footer>

    <script>
      const logoutBtn = document.getElementById("logout-btn");
      logoutBtn?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        localStorage.removeItem("token");
        localStorage.removeItem("user");
        window.location.href = "/";
      });
    </script>
  </body>
</html>
