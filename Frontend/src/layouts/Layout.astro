---
import Nav from "../components/site/Nav.astro";
import Footer from "../components/site/Footer.astro";
import AsesorIA from "../components/react/AsesorIA.tsx";
import CarritoUI from "../components/react/CarritoUI.tsx";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  navMode?: "overlay" | "solid";
  /** Fuerza el wordmark a tinta plana (fondos claros donde el dorado no
   *  contrasta). Por defecto va bicolor en todo el sitio. */
  wordmarkPlano?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = "Diseño y mobiliario de alta gama pensado para crear ambientes únicos.",
  navMode = "solid",
  wordmarkPlano = false,
  bodyClass = "bg-black text-white",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Kapakana&family=Playfair+Display:wght@500&family=Sofia+Sans+Semi+Condensed:wght@300;500;700&family=Inclusive+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | JK Mobiliario</title>
  </head>
  <body class={bodyClass}>
    <Nav mode={navMode} wordmarkPlano={wordmarkPlano} />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Asesor IA y carrito: islas diferidas para no afectar los Core Web Vitals. -->
    <AsesorIA client:idle />
    <CarritoUI client:idle />

    <!--
      Registro de visitas. Es lo que alimenta el reporte de tráfico del panel
      (/admin/trafico): sin esto, el reporte solo puede mostrar el panel, no a
      los visitantes de la tienda.

      Tres decisiones que conviene no deshacer:

      - Se manda **sin cuerpo**, con los datos en la query. `sendBeacon` no hace
        preflight de CORS, y un `Content-Type: application/json` desde la tienda
        (web.jkmobiliario.digital) hacia la API (api.jkmobiliario.digital) lo
        exigiría: el beacon se perdería en silencio. Un POST sin cuerpo ni
        cabeceras propias sí es una petición simple.
      - No mide /admin, /login ni /cambio-password. Son páginas del personal, y
        contarlas inflaría el tráfico con quien está trabajando en el panel.
      - Respeta "Do Not Track". El servidor no guarda IP ni navegador (solo un
        hash que cambia cada día), así que no hay banner de cookies que poner;
        pero si alguien pide explícitamente no ser seguido, no se cuenta.
    -->
    <script>
      import { API_URL } from "../lib/apiBase";

      const RUTAS_SIN_MEDIR = ["/admin", "/login", "/cambio-password"];

      const ruta = window.location.pathname;
      const esPaginaDelPersonal = RUTAS_SIN_MEDIR.some(
        (prefijo) => ruta === prefijo || ruta.startsWith(`${prefijo}/`)
      );
      const pideNoSerSeguido =
        navigator.doNotTrack === "1" ||
        (window as unknown as { doNotTrack?: string }).doNotTrack === "1";

      if (!esPaginaDelPersonal && !pideNoSerSeguido && typeof navigator.sendBeacon === "function") {
        try {
          const parametros = new URLSearchParams({ ruta });
          if (document.referrer) parametros.set("referidor", document.referrer);
          navigator.sendBeacon(`${API_URL}/api/trafico/visita?${parametros.toString()}`);
        } catch {
          // Si el navegador bloquea el beacon (modo privado, extensión), la
          // visita simplemente no se cuenta: no es algo que deba ver el cliente.
        }
      }
    </script>
  </body>
</html>
